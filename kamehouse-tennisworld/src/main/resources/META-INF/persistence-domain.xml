<persistence xmlns="http://java.sun.com/xml/ns/persistence"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
  version="2.0">
  <persistence-unit name="kamehouseDomain"
    transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.nicobrest.kamehouse.tennisworld.model.BookingRequest</class>
    <class>com.nicobrest.kamehouse.tennisworld.model.BookingResponse</class>
    <class>com.nicobrest.kamehouse.tennisworld.model.BookingScheduleConfig</class>
    <class>com.nicobrest.kamehouse.tennisworld.model.TennisWorldUser</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
  </persistence-unit>
</persistence>
