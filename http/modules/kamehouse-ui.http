# Environment variables: ../http-client.env.json

{{
  $global.currentDate = new Date().toISOString().slice(0, 10);
  const daysFromToday = 2;
  const today = new Date();
  const futureDateTemp = new Date(today);
  futureDateTemp.setDate(futureDateTemp.getDate() + daysFromToday);
  $global.futureDate = futureDateTemp.toISOString().slice(0, 10);
}}

### kamehouse-ui / static-content / / home
GET {{SERVER}}/kame-house/

{{
const assert = require('assert');
// TEST - Serves the UI index page

test("Status code is as expected", () => {

  assert.strictEqual(response.statusCode, 200);

});

test("Response is html", () => {

  assert.ok(response.headers['content-type'].includes("text/html"));

});

test("Body contains specified string", () => {

  assert.ok(response.body.includes("KameHouse - Home"));

});
}}

### kamehouse-ui / static-content / / not found
GET {{SERVER}}/kame-house/not-found-page

{{
const assert = require('assert');
// TEST - Serves the UI 404 page

test("Status code is as expected", () => {

  assert.strictEqual(response.statusCode, 404);

});

test("Response is html", () => {

  assert.ok(response.headers['content-type'].includes("text/html"));

});

test("Body contains specified string", () => {

  assert.ok(response.body.includes("404"));

});
}}
