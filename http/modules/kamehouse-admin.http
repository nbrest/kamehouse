### Kamehouse Admin - Users: List all users
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users/

### Kamehouse Admin - Users: Get user by username
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users/username/{{username}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}

### Kamehouse Admin - Users: Get user by ID
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users/{{id}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}

### Kamehouse Admin - Users: Create new user
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users
Authorization: Basic {{USERNAME}} {{PASSWORD}}
Content-Type: application/json

{
    "username": "user_{{$randomInt}}",
    "password": "pass_{{$randomInt}}",
    "email": "user_{{$randomInt}}@example.com",
    "firstName": "Goku",
    "lastName": "Son",
    "authorities": [
        {
            "name": "ROLE_KAMISAMA"
        },
        {
            "name": "ROLE_NAMEKIAN"
        }
    ],
    "accountNonExpired": true,
    "accountNonLocked": true,
    "credentialsNonExpired": true,
    "enabled": true
}

### Kamehouse Admin - Users: Update user by ID
PUT {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users/{{id}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}
Content-Type: application/json

{
    "id": {{id}},
    "username": "user_{{$randomInt}}",
    "password": "pass_{{$randomInt}}",
    "email": "user_{{$randomInt}}@example.com",
    "firstName": "Gohan",
    "lastName": "Son",
    "authorities": [
        {
            "name": "ROLE_ADMIN"
        },
        {
            "name": "ROLE_GUEST"
        }
    ],
    "accountNonExpired": true,
    "accountNonLocked": true,
    "credentialsNonExpired": true,
    "enabled": true
}

### Kamehouse Admin - Users: Delete user by ID
DELETE {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users/{{id}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}

### Kamehouse Admin - Users: Get user by invalid username (Expect 404)
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users/username/{{invalidUsername}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}

### Kamehouse Admin - Users: Get user by invalid ID (Expect 404)
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users/{{invalidId}}

### Kamehouse Admin - Users: Invalid create request (Expect 400)
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users
Content-Type: application/json

{
    "firstName": "Invalid",
    "lastName": "User",
    "authorities": [
        {
            "name": "ROLE_KAMISAMA"
        }
    ],
    "accountNonExpired": true,
    "accountNonLocked": true,
    "credentialsNonExpired": true,
    "enabled": true
}

### Kamehouse Admin - Users: Update non-existent user ID (Expect 404)
PUT {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users/{{invalidId}}
Content-Type: application/json

{
    "id": {{invalidId}},
    "username": "nonexistent",
    "password": "password",
    "email": "test@example.com",
    "firstName": "Test",
    "lastName": "User",
    "authorities": [
        {
            "name": "ROLE_ADMIN"
        }
    ],
    "accountNonExpired": true,
    "accountNonLocked": true,
    "credentialsNonExpired": true,
    "enabled": true
}

### Kamehouse Admin - Users: Delete non-existent user ID (Expect 404)
DELETE {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/kamehouse/users/{{invalidId}}


### Power Management - Reboot
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/reboot-REMOVE-ME-BUT-THIS-WILL-REBOOT-THE-SERVER!
Content-Type: application/json

### Power Management - Get Shutdown status
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/shutdown

### Power Management - Schedule Shutdown (delay = 5400s)
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/shutdown?delay=5400
Content-Type: application/json

### Power Management - Cancel Shutdown
DELETE {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/shutdown

### Power Management - Get Suspend status
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/suspend

### Power Management - Schedule Suspend (delay = 5400s)
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/suspend?delay=5400
Content-Type: application/json

### Power Management - Cancel Suspend
DELETE {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/suspend

### Power Management - Wake-on-LAN (MAC & Broadcast)
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/wol?mac=8C:04:BA:A6:F2:B1&broadcast=192.168.0.255
Content-Type: application/json

### Power Management - Wake-on-LAN (Server name)
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/wol?server=media.server
Content-Type: application/json

### Power Management - Wake-on-LAN (Invalid server - Expect 400)
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/power-management/wol?server=invalidServer
Content-Type: application/json


### Screen - Lock
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/screen/lock
Content-Type: application/json

### Screen - Unlock
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/screen/unlock
Content-Type: application/json

### Screen - Wake Up
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/screen/wake-up
Content-Type: application/json


### System State - HTTPD (GET)
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/system-state/httpd
Content-Type: application/json

### System State - HTTPD (POST)
POST {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/system-state/httpd
Content-Type: application/json

### System State - Uptime
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/system-state/uptime
Content-Type: application/json

### System State - Free memory
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/system-state/free
Content-Type: application/json

### System State - Disk Free (df)
GET {{SERVER}}/kame-house-admin/api/{{apiVersion}}/admin/system-state/df
Content-Type: application/json


### Commons - Set log level to TRACE
PUT {{SERVER}}/kame-house-admin/api/{{apiVersion}}/commons/log-level/trace
