{{
  $global.currentDate = new Date().toISOString().slice(0, 10);
  const daysFromToday = 2;
  const today = new Date();
  const futureDateTemp = new Date(today);
  futureDateTemp.setDate(futureDateTemp.getDate() + daysFromToday);
  $global.futureDate = futureDateTemp.toISOString().slice(0, 10);
}}

### kamehouse-admin / admin / kamehouse / users / /
GET {{SERVER}}/kame-house-admin/api/{{API_VERSION}}/admin/kamehouse/users
Authorization: Basic {{USERNAME}} {{PASSWORD}}

{{
const assert = require('assert');
// --------------------------------------------------------------------------
// Set/Unset global variables used in other requests
// --------------------------------------------------------------------------
var responseJson = response.parsedBody;
$global.id = responseJson[0].id;
$global.username = responseJson[0].username;

// --------------------------------------------------------------------------
// Response Code Tests
// --------------------------------------------------------------------------
// TEST - Response code has the expected value
test("Status code is as expected", () => {
    assert.strictEqual(response.statusCode, 200);
});

// --------------------------------------------------------------------------
// Response Body Tests
// --------------------------------------------------------------------------

// TEST - Response body has content
test("Response has a body", () => {
      assert.ok(response.body != null && response.body !== '');
});

// TEST - Response body is json
test("Response body is json", () => {
      assert.doesNotThrow(() => JSON.parse(response.body));
});

// TEST - Response body contains specifed string
var expectedContent = "ROLE_KAMISAMA";
test("Body contains specified string", () => {
    assert.ok(response.body.includes(expectedContent));
});

// TEST - Response body contains specifed string
var expectedContent = "\"password\":null,";
test("Passwords are hidden", () => {
    assert.ok(response.body.includes(expectedContent));
});
}}

