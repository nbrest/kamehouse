### kamehouse-groot / auth / login.php
# @noRedirect
POST {{SERVER}}/kame-house-groot/api/v1/auth/login.php
Content-Type: application/x-www-form-urlencoded

username={{USERNAME}}&password={{PASSWORD}}

{{
const assert = require('assert');
// TEST - Response code has the expected value

test("Status code is as expected", () => {

  assert.strictEqual(response.statusCode, 302);

});

// TEST - Redirects to the groot home page on successful login

test("Redirects to groot home", () => {

  assert.ok(response.headers['location'].includes("/kame-house/groot/"));

});
}}

### kamehouse-groot / auth / logout.php
# @noRedirect
GET {{SERVER}}/kame-house-groot/api/v1/auth/logout.php

{{
const assert = require('assert');
// TEST - Response code has the expected value

