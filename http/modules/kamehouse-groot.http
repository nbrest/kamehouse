### kamehouse-groot / commons / session / status basic auth
GET {{GROOT_SERVER}}/kame-house-groot/api/v1/commons/session/status
Authorization: Basic {{USERNAME}} {{PASSWORD}}

{{
const assert = require('assert');
test("Status code is as expected", () => {
  assert.strictEqual(response.statusCode, 200);
});
test("Authenticated user", () => {
  const body = JSON.parse(response.body);
  assert.ok(body.username);
  assert.notStrictEqual(body.username, 'anonymousUser');
  assert.ok(Array.isArray(body.roles));
});
}}

