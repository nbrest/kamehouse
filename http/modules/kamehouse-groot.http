### kamehouse-groot / admin / kamehouse-shell / execute is-linux-host
GET {{GROOT_SERVER}}/kame-house-groot/api/v1/admin/kamehouse-shell/execute?script=is-linux-host.sh
Authorization: Basic {{USERNAME}} {{PASSWORD}}

{{
const assert = require('assert');
test("Status code is as expected", () => {
  assert.strictEqual(response.statusCode, 200);
});
test("Response body is json", () => {
  assert.doesNotThrow(() => JSON.parse(response.body));
});
test("Status is completed", () => {
  const body = JSON.parse(response.body);
  assert.strictEqual(body.status, 'completed');
  assert.strictEqual(body.exitCode, 0);
});
}}

