  $global.currentDate = new Date().toISOString().slice(0, 10);
  const daysFromToday = 2;
  const today = new Date();
  const futureDateTemp = new Date(today);
  futureDateTemp.setDate(futureDateTemp.getDate() + daysFromToday);
  $global.futureDate = futureDateTemp.toISOString().slice(0, 10);
