{
    "email": "{{$randomEmail}}",
    "password": "{{$randomPassword}}"
}

### Tennis World - Update user
PUT {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/users/{{id}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}
Content-Type: application/json

{
    "id": {{id}},
    "username": "{{$randomUserName}}",
    "email": "{{$randomEmail}}",
    "age": {{$randomInt}}
}

### Tennis World - Delete user
DELETE {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/users/{{id}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}


