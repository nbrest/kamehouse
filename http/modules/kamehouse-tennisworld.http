### Tennis World - Get booking schedule configs
GET {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/booking-schedule-configs
Authorization: Basic {{USERNAME}} {{PASSWORD}}

### Tennis World - Get booking schedule config by ID
GET {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/booking-schedule-configs/{{id}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}

### Tennis World - Create booking schedule config
POST {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/booking-schedule-configs
Authorization: Basic {{USERNAME}} {{PASSWORD}}
Content-Type: application/json

{
    "tennisWorldUser" : {
        "email": "{{tennisWorldUser}}"
    },
    "sessionType": "CARD",
    "bookingDate": "2024-01-01",
    "bookingTime": "18:00"
}

### Tennis World - Update booking schedule config
PUT {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/booking-schedule-configs/{{id}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}
Content-Type: application/json

{
    "id": {{id}},
    "username": "{{$randomUserName}}",
    "email": "{{$randomEmail}}",
    "age": {{$randomInt}}
}

### Tennis World - Delete booking schedule config
DELETE {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/booking-schedule-configs/{{id}}
Authorization: Basic {{USERNAME}} {{PASSWORD}}


### Tennis World - Book court
POST {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/bookings
Authorization: Basic {{USERNAME}} {{PASSWORD}}
Content-Type: application/json

{
    "username": "{{tennisWorldUser}}",
    "password": "{{tennisWorldPassword}}",
    "date": "2024-01-01",
    "time": "18:00",
    "court": "1"
}

### Tennis World - Book class
POST {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/bookings
Authorization: Basic {{USERNAME}} {{PASSWORD}}
Content-Type: application/json

{
    "username": "{{tennisWorldUser}}",
    "password": "{{tennisWorldPassword}}",
    "date": "2024-01-01",
    "time": "18:00",
    "class": "ADULTS"
}

### Tennis World - Scheduled bookings
POST {{SERVER}}/kame-house-tennisworld/api/{{apiVersion}}/tennis-world/scheduled-bookings
