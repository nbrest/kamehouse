  assert.ok(response.body != null && response.body !== '');
});

// TEST - Response body is json
test("Response body is json", () => {
  assert.doesNotThrow(() => JSON.parse(response.body));
});

// TEST - Response body contains specifed string
var expectedContent = "com.nicobrest.kamehouse:TRACE";
test("Body contains specified string", () => {
  assert.ok(response.body.includes(expectedContent));
});
}}
