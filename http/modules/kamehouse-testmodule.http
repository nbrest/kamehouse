Authorization: Basic {{USERNAME}} {{PASSWORD}}
Content-Type: application/json

{
    "username": "{{$randomUserName}}",
    "email": "{{$randomEmail}}",
    "age": {{$randomInt}},
    "powerLevel": {{$randomInt}},
    "stamina": {{$randomInt}}
}

